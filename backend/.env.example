# EventWise AI Environment Configuration
# Copy this file to .env and configure secrets appropriately.

# Application Configuration
APP_NAME=EventWise AI
DEBUG=False
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-use-a-strong-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is async SQLite for standalone local testing. PostgreSQL recommended for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventwise
DATABASE_URL=sqlite+aiosqlite:///./eventwise.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# AI Provider Configuration
# Set your Gemini API Key. If empty or invalid, EventWise gracefully switches to its
# deterministic fallback planning engine without failing user operations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & Rate Limiting
DEMO_MODE=True
MAX_REQUEST_SIZE_MB=10
RATE_LIMIT_CALLS_PER_MINUTE=60

